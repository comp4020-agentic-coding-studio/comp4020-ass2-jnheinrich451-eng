---
import { getPublishedCollection } from 'astro-course-university/content';
import { withBase } from 'astro-theme-university/url';
interface Props { current: string }
const { current } = Astro.props;
const sessions = (await getPublishedCollection('sessions')).sort((a,b) => a.data.week-b.data.week);
const index = sessions.findIndex(s => s.id === current);
const active = sessions[index];
const previous = sessions[index-1], next = sessions[index+1];
const names: Record<string,string> = { A: 'Compute it', B: 'Break it', C: 'Live with it' };
const arcOf = (s: typeof active) => String((s.data as Record<string,unknown>).arc ?? '');
const groups = [...new Set(sessions.map(arcOf))].map(arc => ({arc, items: sessions.filter(s=>arcOf(s)===arc)}));
const href = (id: string) => withBase(`/sessions/${id}/`);
---
<nav class="session-scale" aria-label="Course week navigation">
  <div class="scale-heading"><span>Course sequence</span><strong>Week {String(active.data.week).padStart(2,'0')} / {String(sessions.length).padStart(2,'0')}</strong></div>
  <div class="scale-track">
    {groups.map(group => <div class="scale-arc">
      <p>{names[group.arc] ?? group.arc}</p>
      <ol>
        {group.items.map(s => <li><a href={href(s.id)} aria-current={s.id===current?'page':undefined} aria-label={`Week ${s.data.week}: ${s.data.title}`}>
          <span class="marker">{String(s.data.week).padStart(2,'0')}</span>
          <span class="week-title">{s.data.title}</span>
        </a></li>)}
      </ol>
    </div>)}
  </div>
  <div class="scale-current"><span class="current-ring" aria-hidden="true"></span><span>{active.data.title}</span></div>
  {active.data.week === 2 && <a class="lecture-branch" href={withBase('/lectures/week-02/')}><span aria-hidden="true">↳</span> Lecture 02 · Two Gaussians, One Number →</a>}
  <details class="mobile-weeks"><summary>Choose a week</summary><ol>{sessions.map(s=><li><a href={href(s.id)} aria-current={s.id===current?'page':undefined}>Week {s.data.week} · {s.data.title}</a></li>)}</ol></details>
  <div class="adjacent">
    {previous ? <a href={href(previous.id)}><span>← Previous</span><strong>{previous.data.title}</strong></a> : <span>Start of course</span>}
    {next ? <a href={href(next.id)}><span>Next →</span><strong>{next.data.title}</strong></a> : <a href={withBase('/assessments/final-report/')}><span>Next →</span><strong>Final report</strong></a>}
  </div>
</nav>
<style>
  .session-scale { margin: 1.5rem 0 2.5rem; padding: 1.25rem; background: var(--at-bg-alt); border-block: 1px solid var(--at-border); }
  .scale-heading { display:flex; justify-content:space-between; gap:1rem; font: .72rem var(--at-font-mono,monospace); text-transform:uppercase; letter-spacing:.08em; }
  .scale-heading strong {color:var(--at-primary);font-weight:500;}
  .scale-track {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.5rem;}
  .scale-arc p {margin:0 0 1rem;font-size:.78rem;color:var(--at-text-muted);}
  ol {list-style:none;padding:0;margin:0;}
  .scale-arc ol {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));position:relative;}
  .scale-arc ol::before {content:'';position:absolute;top:19px;left:0;right:0;border-top:1px solid var(--at-primary);opacity:.45;}
  .scale-arc a {position:relative;display:grid;justify-items:center;text-decoration:none;color:var(--at-text);min-height:44px;}
  .marker {display:grid;place-items:center;width:38px;height:38px;background:var(--at-bg-alt);border:1px solid var(--at-border);border-radius:50%;font: .72rem var(--at-font-mono,monospace);}
  [aria-current='page'] .marker {border-color:var(--at-primary);box-shadow:0 0 0 4px var(--at-bg-alt),0 0 0 5px var(--at-primary);color:var(--at-primary);font-weight:700;}
  .week-title {position:absolute;top:48px;left:50%;transform:translateX(-50%);width:10rem;padding:.5rem;background:var(--at-bg);border:1px solid var(--at-primary);color:var(--at-text);font-size:.75rem;text-align:center;z-index:5;display:none;}
  a:hover .week-title,a:focus-visible .week-title {display:block;}
  a:focus-visible,summary:focus-visible {outline:2px solid var(--at-primary);outline-offset:5px;}
  a:hover .marker {border-color:var(--at-primary);}
  .scale-current {display:flex;gap:.6rem;align-items:center;margin-top:1.5rem;font-size:.85rem;}
  .current-ring {width:.6rem;height:.6rem;border:1px solid var(--at-primary);border-radius:50%;}
  .lecture-branch {display:block;margin-top:.75rem;padding:.5rem 0 .5rem 1rem;border-left:1px solid var(--at-primary);font-size:.8rem;}
  .adjacent {display:flex;justify-content:space-between;gap:1.5rem;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--at-border);}
  .adjacent a {display:grid;gap:.2rem;text-decoration:none;min-height:44px;max-width:48%;}
  .adjacent a:last-child {text-align:right;}
  .adjacent span {font-size:.7rem;color:var(--at-text-muted);}
  .adjacent strong {font-size:.85rem;font-weight:500;}
  .mobile-weeks {display:none;}
  @media(max-width:600px){
    .session-scale {padding:1rem;}
    .scale-track {display:none;}
    .scale-current {flex-wrap:wrap;}
    .scale-current small {flex-basis:100%;margin-left:0;}
    .mobile-weeks {display:block;margin-top:1rem;}
    summary {padding:.7rem 0;cursor:pointer;color:var(--at-primary);}
    .mobile-weeks a {display:block;padding:.65rem .25rem;font-size:.85rem;}
    .mobile-weeks [aria-current='page'] {font-weight:700;border-left:2px solid var(--at-primary);padding-left:.5rem;}
  }
</style>
