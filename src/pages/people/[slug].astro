---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Map the role enum (convenor|tutor|guest|other) to display labels rather than
// rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};
const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
// Astro's generated type does not retain the image/alt refinement relationship,
// so narrow the alt at the rendering boundary as well.
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title.
const description = person.data.description;
---

<ContentLayout
  title={person.data.title}
  description={description}
  heroImage={person.data.photo ?? undefined}
  heroImageAlt={photoAlt}
  {...siteConfig}
>
  <aside class="profile-notice" aria-label="Prototype context">
    Fictional teaching staff for the Slop University course prototype.
    Research backgrounds, group affiliations and contact details are illustrative.
  </aside>
  <dl class="profile-contact">
    {roleLabel && (
      <>
        <dt>Role</dt>
        <dd>{roleLabel}</dd>
      </>
    )}
    {person.data.affiliation && (
      <>
        <dt>Affiliation</dt>
        <dd>{person.data.affiliation}</dd>
      </>
    )}
    {person.data.email && (
      <>
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${person.data.email}`}>{person.data.email}</a>
        </dd>
      </>
    )}
    {person.data.url && (
      <>
        <dt>Web</dt>
        <dd>
          <a href={person.data.url}>{person.data.url}</a>
        </dd>
      </>
    )}
    <dt>Contact</dt>
    <dd>{person.data.contact}</dd>
  </dl>

  <div class="profile-body"><Content /></div>
</ContentLayout>

<style>
  .profile-notice {border-left:2px solid var(--at-primary);padding:.5rem 1rem;margin-block:0 2rem;font-size:.85rem;line-height:1.6;color:var(--at-text-muted);}
  .profile-contact {display:grid;grid-template-columns:7rem minmax(0,1fr);gap:.7rem 1.5rem;border-block:1px solid var(--at-border);padding-block:1.5rem;margin-block:0 2.5rem;}
  .profile-contact dt {color:var(--at-primary);font:.8rem/1.7 var(--at-font-mono,monospace);}
  .profile-contact dd {margin:0;overflow-wrap:anywhere;line-height:1.7;}
  .profile-body {max-width:70ch;}
  .profile-body :global(h2) {color:var(--at-primary);font-size:clamp(1.4rem,3vw,1.8rem);line-height:1.25;margin-block:2.5rem 1rem;}
  .profile-body :global(p) {line-height:1.8;}
  .profile-body :global(> p:first-child) {font-size:1.15rem;}
  @media(max-width:520px) {.profile-contact {grid-template-columns:minmax(0,1fr);gap:.25rem;}.profile-contact dd {margin-bottom:.75rem;}}
</style>
