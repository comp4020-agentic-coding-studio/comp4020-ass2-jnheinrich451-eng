---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const assessments = await getPublishedCollection("assessments");
// The ongoing log begins in Week 1; its submission deadline remains Week 12.
const visible = assessments.sort((a, b) =>
  Number(b.id === 'measurement-log') - Number(a.id === 'measurement-log') ||
  a.data.week - b.data.week
);
---

<section class="assessment-route" aria-label="Assessment sequence">
  <header><p class="eyebrow">Reproduce / Break / Report</p><h2>The mark is in the account.</h2><p>Reproduce a published number, construct a failure, then defend what you would report instead. The measurement log records what you learned along the way.</p><p class="total">{visible.reduce((sum,a)=>sum+a.data.weight,0)}% <span>of the course · {visible.length} assessments</span></p></header>
  <ol>
    {visible.map((assessment,index)=><li>
      <span class="index" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
      <div class="entry">
        <p class="eyebrow">{assessment.id === 'measurement-log' && 'Starts week 1 · '}Due week {assessment.data.week} · <time datetime={assessment.data.due.toISOString()}>{formatCourseDate(assessment.data.due)}</time>{assessment.data.draft && ' · Draft'}</p>
        <div class="title-row"><h2><a href={withBase(`/assessments/${assessment.id}/`)}>{assessment.data.title}</a></h2><p class="weight">{assessment.data.weight}<span>%</span></p></div>
        <p>{assessment.data.description}</p>
        <a class="open" href={withBase(`/assessments/${assessment.id}/`)}>Read brief & review requirements →</a>
      </div>
    </li>)}
  </ol>
</section>
<style>
  header {max-width:65ch;margin-bottom:3rem;}
  .eyebrow,.index,.open,.total span {font:.75rem var(--at-font-mono,monospace);}
  .eyebrow {color:var(--at-text-muted);line-height:1.7;}
  header h2 {font-size:clamp(2rem,4vw,3rem);letter-spacing:-.04em;line-height:1.1;}
  p {line-height:1.65;}
  .total {font-size:2rem;color:var(--at-primary);border-bottom:1px solid var(--at-primary);padding-bottom:1rem;}
  .total span {color:var(--at-text-muted);}
  ol {list-style:none;padding:0;margin:0;}
  li {position:relative;display:grid;grid-template-columns:2.5rem minmax(0,1fr);gap:1rem;}
  li:not(:last-child)::before {content:'';position:absolute;left:1rem;top:2rem;bottom:0;border-left:1px solid var(--at-border);}
  .index {color:var(--at-primary);padding-top:.7rem;}
  .entry {padding-bottom:2.5rem;margin-bottom:1.5rem;border-bottom:1px solid var(--at-border);}
  .title-row {display:flex;align-items:baseline;gap:1rem;justify-content:space-between;}
  h2 {font-size:1.6rem;line-height:1.2;margin:.5rem 0;}
  h2 a {text-decoration:none;}
  .weight {font-size:2.5rem;margin:0;color:var(--at-primary);white-space:nowrap;}
  .weight span {font-size:1rem;}
  .open {line-height:1.8;}
  a:focus-visible {outline:2px solid var(--at-primary);outline-offset:4px;}
  @media(max-width:650px){li {grid-template-columns:1.5rem minmax(0,1fr);gap:.5rem;}li:not(:last-child)::before {left:.6rem;}.title-row {align-items:flex-start;}h2 {font-size:1.3rem;}.weight {font-size:1.8rem;}}
</style>
