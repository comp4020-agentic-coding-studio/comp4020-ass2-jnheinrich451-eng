---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import EntryMeta from "../../components/EntryMeta.astro";
import RatingCost from "../../components/RatingCost.astro";
import Readings from "../../components/Readings.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import SessionScale from "../../components/SessionScale.astro";
import WorkspaceActivity from "../../components/WorkspaceActivity.astro";
import { workspaceActivities } from "../../data/workspace-activities";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const activity = workspaceActivities[`sessions/${session.id}`];
const { Content, headings } = await render(session);

// `arc`, `required_reading` and `further_reading` are loose keys: the schema
// passes them through without declaring them, so they don't exist on the
// generated types and are read from an untyped view of the same data.
const loose = session.data as Record<string, unknown>;
const arc = typeof loose.arc === "string" ? loose.arc : undefined;
// `instrument` is another loose key: a session names the in-page instrument
// it hands the reader, and the page renders only that one.
const wantsRatingCost = loose.instrument === "rating-cost";
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <EntryMeta week={session.data.week} date={session.data.date} arc={arc} />
  <SessionScale current={session.id} />
  <nav class="session-toc" aria-label="On this page">
    <span>On this page</span>
    {headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text.replace(/#$/, '').trim()}</a>)}
    {wantsRatingCost && <a href="#rating-cost">Cost a rating study</a>}
    {activity && <a href="#workspace-activity">Try it in the workspace</a>}
  </nav>
  <div class="session-reading"><Content /></div>
  {wantsRatingCost && <RatingCost />}
  {activity && <WorkspaceActivity activity={activity} />}
  <Readings required={loose.required_reading} further={loose.further_reading} />
  <SpecList spec={session.data.spec}>
    What you bring to the session. Written so a reader can tell whether it has
    been met without asking you.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
</ContentLayout>

<style>
  .session-toc {display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;padding:1rem 0;margin-bottom:2rem;border-block:1px solid var(--at-border);background:var(--at-bg);font-size:.8rem;z-index:4;}
  .session-toc > span {color:var(--at-text-muted);font-family:var(--at-font-mono,monospace);}
  .session-toc a:focus-visible {outline:2px solid var(--at-primary);outline-offset:3px;}
  .session-reading {max-width:68ch;line-height:1.75;}
  .session-reading :global(h2) {scroll-margin-top:calc(var(--at-nav-height) + 7rem);border-bottom:1px solid var(--at-border);padding-bottom:.5rem;}
  .session-reading :global(img) {display:block;max-width:100%;height:auto;margin:2rem auto;}
  .session-reading :global(pre) {max-width:100%;overflow-x:auto;}
  .session-reading :global(blockquote) {border-left:2px solid var(--at-primary);padding:1rem 1.25rem;background:var(--at-bg-alt);margin-inline:0;}
  @media(min-width:901px){.session-toc {position:sticky;top:var(--at-nav-height);}}
</style>
