---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const lectures = (await getPublishedCollection("lectures")).sort((a,b)=>a.data.week-b.data.week);
const introductions = lectures.filter(lecture=>lecture.data.lecture_format==='demo');
const formal = lectures.filter(lecture=>lecture.data.lecture_format==='formal');
// A lecture may hand the room a deck, an instrument on the page, or reading
// and nothing else. The kicker says which, so no card promises the one it
// does not have.
const carriesInstrument = (lecture: (typeof lectures)[number]) => {
  const loose = lecture.data as Record<string, unknown>;
  return [loose.workbench, loose.extrapolator, loose.instruments, loose.report].includes(true);
};
---

<div class="lecture-programme">
  <header class="programme-intro">
    <p class="programme-kicker">SLOP8412 / Lecture programme</p>
    <h2>The number stays.<br/>The questions change.</h2>
    <p>Deriving the score is only the first defence of it. Return with evidence from the bench to question the estimate, test the instrument and justify the report.</p>
    <p class="programme-count">{formal.length} formal lectures <span aria-hidden="true">+</span> {introductions.length} live introduction</p>
  </header>
  {introductions.map(lecture=>(
    <article class="programme-demo" data-lecture-week={lecture.data.week}>
      <div class="programme-date"><span>Week {String(lecture.data.week).padStart(2,'0')}</span><time datetime={lecture.data.date.toISOString().slice(0,10)}>{formatCourseDate(lecture.data.date)}</time></div>
      <div><p class="programme-kicker">Start here / Live introduction</p><h3><a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a></h3><p>Meet the benchmark. Draw again and watch the estimate move while the population score stays fixed.</p></div>
      <a class="programme-link" href={withBase(`/lectures/${lecture.id}/`)}>Run the bench <span aria-hidden="true">↗</span></a>
    </article>
  ))}
  <section aria-labelledby="formal-lectures-title">
    <div class="programme-section-heading"><h2 id="formal-lectures-title">Four returns to the bench</h2><span>Weeks 02 / 05 / 08 / 11</span></div>
    <ol class="programme-sequence">
      {formal.map((lecture,index)=>(
        <li data-lecture-week={lecture.data.week}>
          <article class="programme-lecture">
            <div class="programme-date"><span class="programme-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><span>Week {String(lecture.data.week).padStart(2,'0')}</span><time datetime={lecture.data.date.toISOString().slice(0,10)}>{formatCourseDate(lecture.data.date)}</time></div>
            <div class="programme-body"><p class="programme-kicker">{lecture.data.lecture_stage==='outline'?'Outline preview / Deck in development':lecture.data.slides?'Formal lecture / Slides available':carriesInstrument(lecture)?'Formal lecture / Instrument in the page':'Formal lecture / Reading available'}</p><h3><a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a></h3><p>{lecture.data.description}</p></div>
            <a class="programme-link" href={withBase(`/lectures/${lecture.id}/`)} aria-label={`${lecture.data.lecture_stage==='outline'?'Preview':'Open'} week ${lecture.data.week}: ${lecture.data.title}`}>{lecture.data.lecture_stage==='outline'?'Preview the lecture':'Open the lecture'} <span aria-hidden="true">↗</span></a>
          </article>
        </li>
      ))}
    </ol>
  </section>
  <footer class="programme-footer"><p>The work between lectures matters.</p><p>Weekly sessions continue across all twelve teaching weeks. Keep the measurement log moving; bring its evidence back to each lecture.</p><a class="programme-link" href={withBase('/sessions/')}>Follow the weekly sessions <span aria-hidden="true">→</span></a></footer>
</div>
<style>
  .lecture-programme {color:var(--at-text);margin-block:1rem 3rem;}
  .programme-intro {padding-block:1rem 2.5rem;}
  .programme-kicker,.programme-date,.programme-count,.programme-link,.programme-section-heading>span {font:.75rem/1.6 var(--at-font-mono,monospace);}
  .programme-kicker {color:var(--at-primary);letter-spacing:.06em;margin:0 0 .7rem;}
  .programme-intro h2 {font-size:clamp(2.2rem,4.4vw,4rem);line-height:1.06;letter-spacing:-.045em;margin:0 0 1.4rem;color:var(--at-text);}
  .programme-intro>p:not(.programme-kicker):not(.programme-count) {max-width:62ch;line-height:1.75;}
  .programme-count {margin:1.5rem 0 0;display:flex;gap:.85rem;flex-wrap:wrap;color:var(--at-primary);}
  .programme-demo,.programme-lecture {display:grid;grid-template-columns:6.5rem minmax(0,1fr) auto;align-items:center;gap:1.8rem;padding:2rem 0;}
  .programme-demo {border-block:1px solid var(--at-primary);margin-bottom:3rem;}
  .programme-date {display:flex;flex-direction:column;gap:.3rem;color:var(--at-primary);}
  .programme-date time {font-size:.65rem;color:var(--at-text);}
  h3 {font-size:clamp(1.35rem,2.2vw,2rem);line-height:1.2;letter-spacing:-.025em;margin:0 0 .7rem;}
  h3 a {color:var(--at-text);text-decoration:none;}
  h3 a:hover {color:var(--at-primary);text-decoration:underline;text-underline-offset:.2em;}
  .programme-demo p:not(.programme-kicker),.programme-body>p:not(.programme-kicker) {font-size:.95rem;line-height:1.7;max-width:58ch;margin:0;}
  .programme-link {display:inline-block;justify-self:start;text-decoration:none;border-bottom:1px solid var(--at-primary);padding:.6rem 0;min-height:2.75rem;box-sizing:border-box;}
  .programme-link:hover {color:var(--at-text);}
  .programme-link:focus-visible,h3 a:focus-visible {outline:2px solid var(--at-primary);outline-offset:5px;}
  .programme-section-heading {display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-bottom:.5rem;}
  .programme-section-heading h2 {font-size:1.15rem;margin:0;border:0;padding:0;color:var(--at-text);}
  .programme-section-heading>span {font-size:.65rem;color:var(--at-primary);}
  .programme-sequence {list-style:none;margin:0;padding:0;}
  .programme-sequence>li {margin:0;padding:0;border-bottom:1px solid var(--at-border);}
  .programme-number {font-size:2.8rem;line-height:1.1;letter-spacing:-.07em;margin-bottom:.6rem;}
  .programme-footer {margin-top:2.5rem;max-width:65ch;}
  .programme-footer>p:first-child {font-size:1.15rem;color:var(--at-primary);}
  .programme-footer>p {line-height:1.7;}
  @media(max-width:1050px){.programme-demo,.programme-lecture {grid-template-columns:5rem minmax(0,1fr);gap:1rem 1.5rem;}.programme-link {grid-column:2;}}
  @media(max-width:500px){.programme-demo,.programme-lecture {grid-template-columns:minmax(0,1fr);gap:1rem;}.programme-date {flex-direction:row;align-items:baseline;flex-wrap:wrap;gap:.8rem;}.programme-number {font-size:1.8rem;margin:0;}.programme-link {grid-column:1;}.programme-section-heading>span {font-size:.7rem;}.programme-intro {padding-bottom:1.5rem;}.programme-demo {margin-bottom:2rem;}}
</style>
