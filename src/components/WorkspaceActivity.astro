---
import {withBase} from 'astro-theme-university/url';
import type {WorkspaceActivity} from '../data/workspace-activities';
interface Props {activity: WorkspaceActivity}
const {activity} = Astro.props;
---
<section id="workspace-activity" class="workspace-activity" aria-labelledby="workspace-activity-title">
  <header>
    <p class="activity-kicker">Supporting experiment / Workspace</p>
    <h2 id="workspace-activity-title">{activity.title}</h2>
  </header>
  <ol class="activity-steps">
    <li><h3><span>01</span> Predict</h3><p>{activity.predict}</p></li>
    <li><h3><span>02</span> Open the lab</h3><div><a class="activity-link" href={withBase(activity.lab.href)}>{activity.lab.label} <span aria-hidden="true">↗</span></a><p>{activity.open}</p></div></li>
    <li><h3><span>03</span> Record</h3><p>{activity.record}</p></li>
    <li><h3><span>04</span> Result</h3><p>{activity.result}</p></li>
    <li><h3><span>05</span> Explain the limitation</h3><p>{activity.limitation}</p></li>
  </ol>
  <p class="activity-policy">Keep this supporting experiment distinct from the task above. <a href={withBase('/policies/#browser-workspaces')}>Workspace use and reporting guidance →</a></p>
</section>
<style>
  .workspace-activity {margin-block:2.5rem;max-width:72ch;border-block:1px solid var(--at-primary);padding-block:1.5rem;scroll-margin-top:calc(var(--at-nav-height) + 7rem);}
  .workspace-activity .activity-kicker {font:.75rem var(--at-font-mono,monospace);color:var(--at-primary);margin:0 0 .75rem;}
  .workspace-activity h2 {font-size:clamp(1.4rem,3vw,1.9rem);line-height:1.2;color:var(--at-primary);margin:0 0 1.5rem;}
  .workspace-activity .activity-steps {list-style:none;padding:0;margin:0;}
  .workspace-activity .activity-steps > li {display:grid;grid-template-columns:11rem minmax(0,1fr);gap:1rem;margin:0;padding:1rem 0;border-top:1px solid var(--at-border);}
  .workspace-activity h3 {font:500 .8rem/1.6 var(--at-font-mono,monospace);color:var(--at-primary);margin:0;}
  .workspace-activity h3 span {display:block;font-size:.7rem;}
  .workspace-activity p {font-size:.95rem;line-height:1.7;margin:0;overflow-wrap:anywhere;}
  .workspace-activity .activity-link {display:inline-block;margin:0 0 .5rem;font-weight:600;line-height:1.6;text-underline-offset:.25em;}
  .workspace-activity a:focus-visible {outline:2px solid var(--at-primary);outline-offset:4px;}
  .workspace-activity .activity-policy {border-top:1px solid var(--at-border);padding-top:1rem;font-size:.85rem;}
  @media(max-width:600px){.workspace-activity .activity-steps > li {grid-template-columns:minmax(0,1fr);gap:.5rem;}.workspace-activity h3 span {display:inline;margin-right:.6rem;}}
</style>
