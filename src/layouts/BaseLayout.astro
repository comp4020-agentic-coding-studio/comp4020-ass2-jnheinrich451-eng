---
import ThemeLayout,{type BaseLayoutProps} from 'astro-theme-university/layouts/BaseLayout.astro';
import CourseNavigation from '../components/CourseNavigation.astro';
type Props=BaseLayoutProps;
---
<ThemeLayout {...Astro.props}>
  <Fragment slot="head"><CourseNavigation /><slot name="head" /></Fragment>
  <slot name="hero" slot="hero" />
  <slot />
  <slot name="footer-legal" slot="footer-legal" />
</ThemeLayout>
