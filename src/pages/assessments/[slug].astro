---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import AssessmentChecklist from "../../components/AssessmentChecklist.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import WorkspaceActivity from "../../components/WorkspaceActivity.astro";
import { workspaceActivities } from "../../data/workspace-activities";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const activity = workspaceActivities[`assessments/${assessment.id}`];
const { Content } = await render(assessment);
// Surface the existing submission instruction; keep the authored brief authoritative.
const submission = assessment.body?.replace(/\r\n/g,'\n').match(/Submit [\s\S]*?(?=\n\n|\n\d+\.|$)/)?.[0].replace(/\s+/g,' ').trim();
---

<ContentLayout
  title={assessment.data.title}
  description={assessment.data.description}
  {...siteConfig}
>
  {
    assessment.data.draft && (
      <Callout type="warning">
        <p>
          <strong>Draft.</strong> This brief is still being finalised and may change.
        </p>
      </Callout>
    )
  }
  <div class="assessment-facts">
    <div><p class="fact-label">Due · Week {assessment.data.week}</p><p><time datetime={assessment.data.due.toISOString()}>{formatCourseDate(assessment.data.due)}</time></p></div>
    <div><p class="fact-label">Course weight</p><p class="fact-weight">{assessment.data.weight}%</p></div>
    {submission && <div class="submission"><p class="fact-label">What to submit</p><p>{submission}</p></div>}
  </div>
  <nav class="brief-nav" aria-label="Assessment sections"><a href="#assessment-brief">Brief ↓</a><a href="#assessment-spec">Review spec ↓</a>{assessment.data.marking && <a href="#how-marked">Marking ↓</a>}{activity && <a href="#workspace-activity">Workspace practice ↓</a>}</nav>
  <div id="assessment-brief" class="assessment-reading"><Content /></div>
  {activity && <WorkspaceActivity activity={activity} />}
  <AssessmentChecklist id={assessment.id} spec={assessment.data.spec} />
  {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}
  <RelatedContent entry={assessment} collections={graphCollections} />
</ContentLayout>
<style>
  .assessment-facts {display:grid;grid-template-columns:2fr 1fr;gap:1rem 2rem;border-block:1px solid var(--at-primary);padding-block:1.25rem;margin-block:1.5rem;}
  .assessment-facts p {margin:0;line-height:1.65;}
  .assessment-facts .fact-label {font:.7rem var(--at-font-mono,monospace);text-transform:uppercase;color:var(--at-text-muted);margin-bottom:.5rem;}
  .fact-weight {font-size:2rem;color:var(--at-primary);}
  .submission {grid-column:1/-1;}
  .brief-nav {display:flex;flex-wrap:wrap;gap:1.5rem;margin-block:1.5rem 2.5rem;font:.8rem var(--at-font-mono,monospace);}
  .brief-nav a:focus-visible {outline:2px solid var(--at-primary);outline-offset:4px;}
  .assessment-reading {max-width:68ch;line-height:1.75;}
  .assessment-reading :global(h2) {margin-top:2.5rem;padding-bottom:.5rem;border-bottom:1px solid var(--at-border);}
  #assessment-brief,:global(#assessment-spec),:global(#how-marked) {scroll-margin-top:calc(var(--at-nav-height) + 1rem);}
  @media(max-width:650px){.assessment-facts {gap:1rem;}.brief-nav {gap:1rem;}}
</style>
