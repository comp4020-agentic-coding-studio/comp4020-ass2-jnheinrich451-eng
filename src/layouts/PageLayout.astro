---
import MdxPageLayout from "astro-theme-university/layouts/MdxPageLayout.astro";
import { siteConfig } from "../site-config";
import CourseNavigation from '../components/CourseNavigation.astro';
import SearchDismissal from '../components/SearchDismissal.astro';
import DefaultTheme from '../components/DefaultTheme.astro';
---

<MdxPageLayout siteConfig={siteConfig} {...Astro.props}>
  <Fragment slot="head"><DefaultTheme /><CourseNavigation /><SearchDismissal /><slot name="head" /></Fragment>
  <slot />
</MdxPageLayout>
